{
  "name": "PhotoWizard — private photo editor",
  "short_name": "PhotoWizard",
  "description": "Edit photos in your browser: crop, rotate, resize, remove plain backgrounds and apply filters. Nothing is uploaded.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#110F1A",
  "theme_color": "#6D4AFF",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
